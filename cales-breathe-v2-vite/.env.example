# =============================================================================
# cales-breathe-v2-vite — 複製為同目錄 .env（勿提交版本庫）
# =============================================================================
# 僅在執行 npm run dev / npm run build 時，Vite 會把 VITE_* 編進前端。
#
# Docker：gateway 映像建置時使用「repo 根目錄」的 .env / 環境變數
# （見根目錄 .env.example 的 VITE_*），不是這個檔案。若只改這裡，請本機
# npm run build 驗證；docker compose 請改根目錄並重建 gateway。
# =============================================================================

# API 基底網址（勿結尾斜線）
#
# 模式 A — 本機 dev，瀏覽器直打後端埠
#   VITE_API_BASE=http://127.0.0.1:8000
#
# 模式 B — Docker gateway（同網域 + /api）
#   VITE_API_BASE=http://localhost/api
#   若 GATEWAY_HTTP_PORT=8080 → http://localhost:8080/api
#
VITE_API_BASE=http://127.0.0.1:8000

# LINE 加好友等連結（Login / 預約頁等會引用）
VITE_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@033ikgzv
