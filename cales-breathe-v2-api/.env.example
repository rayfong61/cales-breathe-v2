# LINE Webhook 驗簽（必要）
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE 回覆/推播
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 業主的 LINE User ID（用於推播新預約通知給業主）
# 取得方式：業主傳訊給 Bot 後，webhook 的 source.userId 即為此值
OWNER_LINE_USER_ID=

# JWT（登入用；請填夠長隨機字串，例：python -c "import secrets; print(secrets.token_urlsafe(48))"）
JWT_SECRET=

# Cookie 開關（本機 HTTP 測試可用 false/lax；正式環境建議 true/none）
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# 前端公開網址（OAuth 完成後整頁導向；popup 時亦用於 postMessage target）
FRONTEND_PUBLIC_ORIGIN=http://localhost:3000

# API 公開網址（OAuth redirect_uri 必須與 Google/LINE 後台登記一致）
# API_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Google OAuth（Google Cloud Console → OAuth 2.0 Client）
# 授權重新導向 URI：{API_PUBLIC_BASE_URL}/auth/google/callback
# 亦相容舊專案變數名：GOOGLE_CLIENT_ID、GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# LINE Login（LINE Developers → LINE Login channel，與 Messaging API channel 可不同）
# Callback URL：{API_PUBLIC_BASE_URL}/auth/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# 資料庫：未設定時本機預設 sqlite；正式環境請設 DATABASE_URL。
# SQLite：
DATABASE_URL=sqlite:///./app.db

# PostgreSQL（本專案會轉成 postgresql+psycopg2://）
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Render × Supabase（建議：Session pooler Port 5432）---
# 將 [YOUR-PASSWORD] 換成 Dashboard 的資料庫密碼（含特殊字元請 URL 編碼）。
# 程式會將 postgres:// / postgresql:// 轉成 postgresql+psycopg2://。
#
# DATABASE_URL=postgresql://postgres.vkjxcblftbgqinbegshq:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=prefer
#
# 可選覆寫（預設已為 Session pooler 優化：pool 10/5、timeout 30、recycle 280）
# DB_CONNECT_TIMEOUT=30
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=280
#
# Transaction pooler（:6543）僅供實驗；程式會自動用 NullPool，上述 DB_POOL_* 不適用。
# DATABASE_URL=postgresql://postgres.vkjxcblftbgqinbegshq:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=prefer

# 檔案儲存後端：local | r2
STORAGE_BACKEND=local

# Cloudflare R2（STORAGE_BACKEND=r2 時需要）
# R2 S3 API endpoint 會是：https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 建議填綁定到 bucket 的公開網域（自訂網域或 r2.dev），例如：
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=
# 可選：物件 key 前綴
R2_KEY_PREFIX=uploads