# =============================================================================
# cales-breathe-v2-api — 複製為同目錄 .env（勿提交版本庫）
# =============================================================================
# Docker Compose：根目錄 docker-compose.yml 會覆寫 DATABASE_URL，改連 postgres
# 服務；其餘變數仍由此檔載入。瀏覽器經 gateway 測試時請用下方「同網域」組合。
# =============================================================================

# --- 公開網址（OAuth、Cookie、CORS 相關；須與實際瀏覽器網址一致）---
#
# 模式 A — 本機 vite dev（前端 :3000、API :8000）
#   FRONTEND_PUBLIC_ORIGIN=http://localhost:3000
#   API_PUBLIC_BASE_URL=http://127.0.0.1:8000
#
# 模式 B — Docker gateway（同埠；例 http://localhost 或 http://localhost:8080）
#   FRONTEND_PUBLIC_ORIGIN=http://localhost
#   API_PUBLIC_BASE_URL=http://localhost/api
#
FRONTEND_PUBLIC_ORIGIN=http://localhost:3000
API_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Cookie（本機 HTTP：false + lax；HTTPS 正式站：true + none 等）
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# JWT（請改為長隨機字串；例：python -c "import secrets; print(secrets.token_urlsafe(48))"）
JWT_SECRET=

# Access／Refresh（HttpOnly Cookie；refresh 於 DB 儲存 hash、可撤銷與輪替）
# ACCESS_TOKEN_TTL_MINUTES=60
# REFRESH_TOKEN_TTL_DAYS=30
# ACCESS_TOKEN_COOKIE_NAME=cb_access_token
# REFRESH_TOKEN_COOKIE_NAME=cb_refresh_token

# --- API 文件保護（/docs、/redoc、/openapi.json）---
# 正式環境判定：ENVIRONMENT=production（或 APP_ENV=production）
# ENVIRONMENT=production
#
# 正式環境預設：若未設定 DOCS_BASIC_USER / DOCS_BASIC_PASSWORD，文件路由會關閉。
# 若想在正式環境保留文件，請設定下列帳密啟用 HTTP Basic 保護。
# DOCS_BASIC_USER=your_docs_user
# DOCS_BASIC_PASSWORD=your_strong_password
#
# 強制關閉文件（任何環境）：1/true/yes/on
# DISABLE_API_DOCS=0

# --- LINE Messaging（Webhook 驗簽、回覆、推播）---
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 業主 LINE User ID（新預約推播）；加官方帳號後由 webhook 日誌取得
OWNER_LINE_USER_ID=

# --- LINE Login（與 Messaging channel 可不同）---
# Callback：{API_PUBLIC_BASE_URL}/auth/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# --- Google OAuth ---
# 重新導向 URI：{API_PUBLIC_BASE_URL}/auth/google/callback
# 亦相容：GOOGLE_CLIENT_ID、GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Calendar（選用；服務帳號 JSON 字串或檔案路徑由程式解析）---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary

# --- 資料庫 ---
# 本機直跑 uvicorn：預設 SQLite；設 DATABASE_URL 可改 PostgreSQL。
# Docker Compose：此值會被 compose 覆寫，可保留預設僅作本機非 Docker 使用。
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/cales

# --- Rate limiting / Redis（登入限流等）---
# 本機開發可用本機 Redis（例如：docker run -d -p 6379:6379 redis:7-alpine）
# 正式環境可指向 Upstash Redis 或 Memorystore 等雲端服務。
# 例：REDIS_URL=redis://localhost:6379/0
# 例（Upstash）：REDIS_URL=rediss://:<UPSTASH_PASSWORD>@<UPSTASH_HOST>:<PORT>
REDIS_URL=

# 登入路由 Token Bucket 參數（可依需求調整）
# 同一 IP + 帳號，最多瞬間 5 次登入嘗試，約每 30 秒回復 1 次額度。
LOGIN_RATE_LIMIT_BUCKET_CAPACITY=5
LOGIN_RATE_LIMIT_FILL_RATE_PER_SEC=0.0333

# PostgreSQL 連線池（選用；Session pooler 情境預設已可沿用）
# DB_CONNECT_TIMEOUT=30
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=280

# --- 檔案儲存：local | r2 ---
STORAGE_BACKEND=local

# Cloudflare R2（STORAGE_BACKEND=r2 時必填）
# Endpoint 形式：https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=uploads
