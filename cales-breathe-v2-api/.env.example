# =============================================================================
# cales-breathe-v2-api — 複製為同目錄 .env（勿提交版本庫）
# =============================================================================
# Docker Compose：根目錄 docker-compose.yml 會覆寫 DATABASE_URL，改連 postgres
# 服務；其餘變數仍由此檔載入。瀏覽器經 gateway 測試時請用下方「同網域」組合。
# =============================================================================

# --- LINE Messaging：Webhook 驗簽（必要；與 LINE Developers 頻道 Secret 一致）---
# 未設定或錯誤時，Webhook 無法通過簽章驗證。
LINE_CHANNEL_SECRET=

# --- LINE Messaging：回覆／推播（Channel access token；長效 token）---
LINE_CHANNEL_ACCESS_TOKEN=

# --- JWT（登入 HttpOnly Cookie、HS256 簽章；請改為長隨機字串）---
# 例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Access／Refresh（HttpOnly Cookie；refresh 於 DB 儲存 hash、可撤銷與輪替）
# ACCESS_TOKEN_TTL_MINUTES=60
# REFRESH_TOKEN_TTL_DAYS=30
# ACCESS_TOKEN_COOKIE_NAME=cb_access_token
# REFRESH_TOKEN_COOKIE_NAME=cb_refresh_token

# --- Cookie 開關（本機 HTTP：false + lax；HTTPS 正式站：true + none 等）---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- 資料庫 ---
# 本機直跑 uvicorn：預設 SQLite；設 DATABASE_URL 可改 PostgreSQL。
# Docker Compose：此值會被 compose 覆寫，可保留預設僅作本機非 Docker 使用。
#
# Supabase PostgreSQL（Google Cloud 託管區域等；依專案主控台連線字串為準）
# Session pooler 範例（埠常為 6543）：
# DATABASE_URL=postgresql://postgres.[id]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./app.db

# --- Google OAuth（登入）---
# 重新導向 URI：{API_PUBLIC_BASE_URL}/auth/google/callback
# 亦相容：GOOGLE_CLIENT_ID、GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- LINE Login（與 Messaging channel 可不同）---
# Callback：{API_PUBLIC_BASE_URL}/auth/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# --- 公開網址（OAuth callback、Cookie Domain、CORS；須與瀏覽器實際網址一致）---
#
# 模式 A — 本機 vite dev（前端 :3000、API :8000）
#   FRONTEND_PUBLIC_ORIGIN=http://localhost:3000
#   API_PUBLIC_BASE_URL=http://127.0.0.1:8000
#
# 模式 B — Docker gateway（同埠；例 http://localhost 或 http://localhost:8080）
#   FRONTEND_PUBLIC_ORIGIN=http://localhost
#   API_PUBLIC_BASE_URL=http://localhost/api
#
FRONTEND_PUBLIC_ORIGIN=http://localhost:3000
API_PUBLIC_BASE_URL=http://127.0.0.1:8000

# 容器內每 10 分鐘 ping /health（預設關閉；Cloud Run 請勿開，改見 docs/CLOUD_RUN_COST_AND_WARMUP_PLAN.md）
# ENABLE_KEEP_ALIVE=true

# --- 檔案儲存：local | r2 ---
# 本機開發可維持 local；正式上傳頭像等改 r2 並填妥下列欄位。
STORAGE_BACKEND=local

# Cloudflare R2（STORAGE_BACKEND=r2 時必填）
# API Endpoint 形式：https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=uploads

# --- 業主 LINE User ID（新預約推播等）；加官方帳號後可由 Webhook 日誌取得 ---
OWNER_LINE_USER_ID=

# --- Google Calendar 整合（選用）---
# 服務帳號 JSON 字串或檔案路徑由程式解析；日曆 ID 常為 primary 或共用日曆 ID
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary

# --- Redis／登入限流（本機直跑 uvicorn 或未來 Cloud Run 皆可指向同一 REDIS_URL）---
# 本機：docker run -d -p 6379:6379 redis:7-alpine
# 雲端例（Upstash）：REDIS_URL=rediss://:<PASSWORD>@<HOST>:<PORT>
REDIS_URL=redis://localhost:6379/0

# 登入路由 Token Bucket：同一 IP + 帳號，約每 30 秒回復 1 次額度（可調）
LOGIN_RATE_LIMIT_BUCKET_CAPACITY=5
LOGIN_RATE_LIMIT_FILL_RATE_PER_SEC=0.0333

# --- API 文件保護（/docs、/redoc、/openapi.json）---
# 正式環境判定：ENVIRONMENT=production（或 APP_ENV=production）
# ENVIRONMENT=production
#
# 正式環境預設：若未設定 DOCS_BASIC_USER / DOCS_BASIC_PASSWORD，文件路由會關閉。
# 若想在正式環境保留文件，請設定下列帳密啟用 HTTP Basic 保護。
# DOCS_BASIC_USER=your_docs_user
# DOCS_BASIC_PASSWORD=your_strong_password
#
# 強制關閉文件（任何環境）：1/true/yes/on
# DISABLE_API_DOCS=0

# PostgreSQL 連線池（選用；Session pooler 情境預設已可沿用）
# DB_CONNECT_TIMEOUT=30
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=280

# =============================================================================
# GitHub Actions（.github/workflows/api-cd.yml）— Repository Secrets
# =============================================================================
# 下列為「部署到 Cloud Run」時在 GitHub：Settings → Secrets and variables → Actions
# 設定的名稱；本機 FastAPI 不會從 .env 讀取這些鍵，僅列於此方便對照文件。
# =============================================================================
# GCP_PROJECT_ID=
# GCP_REGION=
# GAR_REPOSITORY=
# CLOUD_RUN_SERVICE=
# GCP_WIF_PROVIDER=
# GCP_SA_EMAIL=
