# --- docker compose（複製為 .env 置於本目錄；compose 會自動讀取）---
POSTGRES_USER=cales
POSTGRES_PASSWORD=請改為強密碼
POSTGRES_DB=cales

# 對外埠（主機 80 被占用時改 8080 等）
GATEWAY_HTTP_PORT=80

# 前端建置時寫入（經由 gateway 存取 API 時為「同網域 + /api」）
# 若 GATEWAY_HTTP_PORT=8080，請改成 http://localhost:8080/api
VITE_API_BASE=http://localhost/api
VITE_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@033ikgzv

# --- 後端 cales-breathe-v2-api/.env ---
# Docker 會用 compose 的 DATABASE_URL 覆寫資料庫連線；其餘 JWT、LINE、Google 等仍讀 api 專案內 .env。
# 本機用瀏覽器經 gateway 測 OAuth 時建議：
# FRONTEND_PUBLIC_ORIGIN=http://localhost
# API_PUBLIC_BASE_URL=http://localhost/api
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
